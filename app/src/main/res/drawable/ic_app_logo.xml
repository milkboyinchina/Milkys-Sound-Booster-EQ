<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="128"
    android:viewportHeight="128">

    <!-- Background rounded shape -->
    <path
        android:pathData="M24,0 L104,0 A24,24 0 0,1 128,24 L128,104 A24,24 0 0,1 104,128 L24,128 A24,24 0 0,1 0,104 L0,24 A24,24 0 0,1 24,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="128"
                android:endY="128"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#FF1D112A" android:offset="0.0" />
                <item android:color="#FF0D0818" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Glowing Dial Ring -->
    <path
        android:pathData="M64,16 A48,48 0 1,1 63.9,16 Z"
        android:strokeWidth="6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="112"
                android:endY="112"
                android:startX="16"
                android:startY="16"
                android:type="linear">
                <item android:color="#FFD0BCFF" android:offset="0.0" />
                <item android:color="#FF7F52FF" android:offset="0.5" />
                <item android:color="#FF381E72" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Equalizer Sound Wave Bars -->
    <!-- Bar 1 (Left) -->
    <path
        android:pathData="M38,76 L38,52"
        android:strokeColor="#FFB388FF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Bar 2 -->
    <path
        android:pathData="M51,88 L51,40"
        android:strokeColor="#FFD0BCFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Bar 3 (Center Peak) -->
    <path
        android:pathData="M64,96 L64,32"
        android:strokeColor="#FFEADD"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Bar 4 -->
    <path
        android:pathData="M77,88 L77,40"
        android:strokeColor="#FFD0BCFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Bar 5 (Right) -->
    <path
        android:pathData="M90,76 L90,52"
        android:strokeColor="#FFB388FF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Central Lightning Accent / Sound Spark -->
    <path
        android:fillColor="#FFD0BCFF"
        android:pathData="M66,22 L58,38 L65,38 L60,50 L70,34 L63,34 Z" />

</vector>
