# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_ADS_API_KEY: Google AdMob App ID (Test ID ca-app-pub-3940256099942544~3347511713)
GOOGLE_ADS_API_KEY=ca-app-pub-3940256099942544~3347511713

# INCLUDE_GOOGLE_ADS: Set to "true" to compile/enable google admob ads, "false" to exclude/disable them
INCLUDE_GOOGLE_ADS=true

# Build Versioning
VERSION_CODE=3
VERSION_NAME=3.0

# Build Output & Logs Locations
BUILD_OUTPUT_DIR=.build-outputs
BUILD_LOGS_DIR=logs
