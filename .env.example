# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_ADS_API_KEY: Google AdMob App ID (Test ID ca-app-pub-3940256099942544~3347511713)
GOOGLE_ADS_API_KEY=ca-app-pub-3940256099942544~3347511713

# BUILD_TARGET: Distribution target build configuration.
# - "playstore": Compiles with Google AdMob & shows AdMob Settings toggle.
# - "fdroid": Compiles without Google AdMob & removes AdMob Settings toggle.
# - "both": Build scripts generate separate APK packages for both Play Store and F-Droid.
BUILD_TARGET=playstore

# INCLUDE_GOOGLE_ADS: Optional boolean override (defaults to "true" for playstore/both, "false" for fdroid)
INCLUDE_GOOGLE_ADS=true

# APPLICATION_ID: Google Play Console Application Package Identifier
APPLICATION_ID=com.milkys.soundbooster

# APP_NAME: Application display name (used for launcher label and app title)
APP_NAME=Milkys Sound Booster & EQ

# Release Signing Keystore Configuration (Optional for Google Play Console upload)
# KEYSTORE_PATH=my-upload-key.jks
# STORE_PASSWORD=your_store_password
# KEY_ALIAS=upload
# KEY_PASSWORD=your_key_password

# Build Versioning
VERSION_CODE=26072401
VERSION_NAME=0.1

# Build Output, Logs & Screenshots Locations
BUILD_OUTPUT_DIR=.build-outputs
BUILD_LOGS_DIR=logs
SCREENSHOT_OUTPUT_DIR=screenshots

# ==============================================================================
# APP ICON & LOGO ASSETS SELECTION LOCATIONS (MULTI-RESOLUTION CONFIGURATION)
# ==============================================================================
# Configure file/directory locations for custom app icons and branding logos across
# different screen densities (mdpi, hdpi, xhdpi, xxhdpi, xxxhdpi).

# --- APP BRANDING LOGO CONFIGURATION ---
# Base directory for custom branding logos
APP_LOGO_DIR=assets/logo

# Base/Default App Logo Path
# Purpose: Main branding image displayed in app top bar, about screen, and splash headers.
APP_LOGO_PATH=assets/logo/app_logo.png

# Multi-Resolution App Logo Locations (Density-Specific Selection):
# - MDPI (1x, ~160dpi, e.g. 48x48px / 120x120px): Medium density displays & entry devices.
APP_LOGO_MDPI_PATH=assets/logo/mdpi/app_logo.png

# - HDPI (1.5x, ~240dpi, e.g. 72x72px / 180x180px): High density displays.
APP_LOGO_HDPI_PATH=assets/logo/hdpi/app_logo.png

# - XHDPI (2x, ~320dpi, e.g. 96x96px / 240x240px): Extra high density 720p/1080p displays.
APP_LOGO_XHDPI_PATH=assets/logo/xhdpi/app_logo.png

# - XXHDPI (3x, ~480dpi, e.g. 144x144px / 360x360px): Extra extra high density 1080p/1440p displays.
APP_LOGO_XXHDPI_PATH=assets/logo/xxhdpi/app_logo.png

# - XXXHDPI (4x, ~640dpi, e.g. 192x192px / 480x480px): Ultra high density 4K displays & Play Store header art.
APP_LOGO_XXXHDPI_PATH=assets/logo/xxxhdpi/app_logo.png

# --- LAUNCHER APP ICON CONFIGURATION ---
# Base directory for custom app launcher icons
APP_ICON_DIR=assets/icon

# Adaptive Launcher Icon Layers:
# - APP_ICON_FOREGROUND_PATH: Purpose: Front vector/PNG icon foreground layer (108x108dp viewport).
APP_ICON_FOREGROUND_PATH=app/src/main/res/drawable/ic_launcher_foreground.xml

# - APP_ICON_BACKGROUND_PATH: Purpose: Back vector/PNG icon canvas background layer (108x108dp viewport).
APP_ICON_BACKGROUND_PATH=app/src/main/res/drawable/ic_launcher_background.xml

# Multi-Resolution Legacy/Raster App Launcher Icons (Density-Specific Selection):
# - MDPI (48x48px launcher icon): Used on legacy MDPI home screens.
APP_ICON_MDPI_PATH=app/src/main/res/mipmap-mdpi/ic_launcher.png

# - HDPI (72x72px launcher icon): Used on HDPI home screens.
APP_ICON_HDPI_PATH=app/src/main/res/mipmap-hdpi/ic_launcher.png

# - XHDPI (96x96px launcher icon): Used on XHDPI home screens.
APP_ICON_XHDPI_PATH=app/src/main/res/mipmap-xhdpi/ic_launcher.png

# - XXHDPI (144x144px launcher icon): Used on standard XXHDPI phone launcher grids.
APP_ICON_XXHDPI_PATH=app/src/main/res/mipmap-xxhdpi/ic_launcher.png

# - XXXHDPI (192x192px launcher icon & 512x512px Play Store store icon): Used on XXXHDPI flagship grids & Play Console listing.
APP_ICON_XXXHDPI_PATH=app/src/main/res/mipmap-xxxhdpi/ic_launcher.png

# GitHub Repository, Developer Website & Privacy Policy URLs
GITHUB_REPO_URL=https://github.com/milkys/sound-booster-eq
DEVELOPER_WEBSITE_URL=https://milkys.app
PRIVACY_POLICY_URL=https://milkys.app/privacy
